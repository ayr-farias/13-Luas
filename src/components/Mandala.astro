---
import { COR_HEX, SELOS, PLASMAS, LUAS, luaNome } from '../lib/data';
import { u } from '../lib/url';

const C = 300;
const pt = (r: number, deg: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [C + r * Math.cos(a), C + r * Math.sin(a)] as const;
};
const f = (n: number) => n.toFixed(1);

// 20 selos no anel externo
const selos = SELOS.map((s, i) => {
  const [x, y] = pt(268, i * 18);
  const [x1, y1] = pt(280, i * 18);
  const [x2, y2] = pt(292, i * 18);
  return { x, y, x1, y1, x2, y2, hex: COR_HEX[s.cor] };
});

// heptagrama {7/2}
const hept = Array.from({ length: 7 }, (_, i) => pt(205, ((i * 2) % 7) * (360 / 7)));
const heptPath = 'M' + hept.map(([x, y]) => `${f(x)} ${f(y)}`).join(' L') + ' Z';
const heptDots = PLASMAS.map((p, i) => ({ p, xy: pt(205, i * (360 / 7)) }));

// 13 luas
const luas = LUAS.map((l, i) => ({ l, xy: pt(236, i * (360 / 13)) }));

// pétalas centrais (13)
const petals = Array.from({ length: 13 }, (_, i) => {
  const [x, y] = pt(70, i * (360 / 13));
  return { x, y, rot: i * (360 / 13) };
});
---
<svg class="mandala" viewBox="0 0 600 600" role="img" aria-label="Mandala das 13 luas, com os 20 selos, os 7 plasmas radiais e as 13 luas">
  <defs>
    <radialGradient id="core" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fff3c4" />
      <stop offset="45%" stop-color="#e2c275" />
      <stop offset="100%" stop-color="#6c4df0" stop-opacity="0.15" />
    </radialGradient>
    <radialGradient id="halo" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#7a5cff" stop-opacity="0.35" />
      <stop offset="100%" stop-color="#7a5cff" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f7e6ae" />
      <stop offset="100%" stop-color="#c79a3e" />
    </linearGradient>
  </defs>

  <circle cx={C} cy={C} r="296" fill="url(#halo)" />

  <g class="spin">
    <circle cx={C} cy={C} r="294" fill="none" stroke="url(#gold)" stroke-width="1.2" stroke-opacity=".8" />
    <circle cx={C} cy={C} r="252" fill="none" stroke="url(#gold)" stroke-width=".8" stroke-opacity=".4" />
    {selos.map((s) => (
      <>
        <line x1={f(s.x1)} y1={f(s.y1)} x2={f(s.x2)} y2={f(s.y2)} stroke={s.hex} stroke-width="1.4" stroke-opacity=".85" />
        <circle cx={f(s.x)} cy={f(s.y)} r="5" fill={s.hex} fill-opacity=".9" />
      </>
    ))}
  </g>

  <g class="spin-r">
    <circle cx={C} cy={C} r="205" fill="none" stroke="#e2c275" stroke-opacity=".25" stroke-width=".8" />
    <path d={heptPath} fill="rgba(122,92,255,.06)" stroke="url(#gold)" stroke-width="1.3" stroke-linejoin="round" />
    {heptDots.map(({ p, xy }) => (
      <circle cx={f(xy[0])} cy={f(xy[1])} r="7" fill={COR_HEX[p.cor]} stroke="#0a0728" stroke-width="2" />
    ))}
  </g>

  <circle cx={C} cy={C} r="150" fill="none" stroke="#e2c275" stroke-opacity=".22" stroke-dasharray="2 7" />
  <circle cx={C} cy={C} r="110" fill="none" stroke="#e2c275" stroke-opacity=".35" />

  <g class="spin">
    {petals.map((p) => (
      <ellipse cx={f(p.x)} cy={f(p.y)} rx="9" ry="30" transform={`rotate(${p.rot} ${f(p.x)} ${f(p.y)})`} fill="rgba(226,194,117,.07)" stroke="#e2c275" stroke-opacity=".5" stroke-width=".9" />
    ))}
  </g>

  <circle cx={C} cy={C} r="52" fill="url(#core)" />
  <circle cx={C} cy={C} r="52" fill="none" stroke="#fff3c4" stroke-opacity=".6" />
  <text class="core-text" x={C} y={C + 7} font-size="22">13 : 20</text>

  {luas.map(({ l, xy }) => (
    <a href={u(`/calendario/#lua-${l.n}`)} class="moon-node" data-lua={l.n} aria-label={`${luaNome(l)}`}>
      <title>{luaNome(l)}</title>
      <circle cx={f(xy[0])} cy={f(xy[1])} r="17" stroke-width="1.2" />
      <text x={f(xy[0])} y={f(xy[1])}>{l.n}</text>
    </a>
  ))}
</svg>

---
// Campo de estrelas determinístico (sempre o mesmo no build).
let seed = 13;
const rnd = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};
const stars = Array.from({ length: 130 }, (_, i) => ({
  x: rnd() * 1000,
  y: rnd() * 1000,
  r: 0.4 + rnd() * 1.3,
  o: 0.25 + rnd() * 0.6,
  tw: i % 4 === 0,
  delay: (rnd() * 4).toFixed(2),
}));
---
<svg class="stars" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {stars.map((s) => (
    <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r.toFixed(2)} opacity={s.o.toFixed(2)} class={s.tw ? 'tw' : undefined} style={s.tw ? `animation-delay:${s.delay}s` : undefined} />
  ))}
</svg>
